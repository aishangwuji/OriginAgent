"""Tests for the {{ pack_name }} domain pack structure."""

from __future__ import annotations

from pathlib import Path

import pytest
import yaml

HERE = Path(__file__).resolve().parent.parent


def test_manifest_is_valid_yaml() -> None:
    manifest_path = HERE / "domain_pack.yaml"
    assert manifest_path.exists(), "domain_pack.yaml is missing"
    raw = yaml.safe_load(manifest_path.read_text(encoding="utf-8"))
    assert isinstance(raw, dict), "domain_pack.yaml must be a mapping"
    assert raw.get("id") == "{{ pack_id }}"
    assert raw.get("name") == "{{ pack_name }}"


def test_capabilities_md_exists() -> None:
    assert (HERE / "CAPABILITIES.md").exists(), "CAPABILITIES.md is missing"


def test_tools_module_exists() -> None:
    tools_dir = HERE / "tools"
    assert tools_dir.is_dir(), "tools/ directory is missing"
    assert (tools_dir / "__init__.py").exists(), "tools/__init__.py is missing"


def test_runtime_module_exists() -> None:
    runtime_dir = HERE / "runtime"
    assert runtime_dir.is_dir(), "runtime/ directory is missing"
    assert (runtime_dir / "__init__.py").exists(), "runtime/__init__.py is missing"
